# =============================================================================
# Vibe — copy to ".env" and fill in values. Never commit .env.
# =============================================================================

# --- Client (Vite) — exposed to browser; use anon key only ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Public site URL (used by client; server can use VITE_APP_URL or REMINDER_STORE_URL)
VITE_APP_URL=http://localhost:5173

# Optional: API base for admin fetch (defaults to same origin in production)
# VITE_API_URL=http://localhost:3001

# --- Server / API ---
PORT=3001
# Set to 0 or false to disable hourly auto-seize of overdue redeem manual payments (default: on when API cron runs)
# REDEEM_AUTO_SEIZE_ENABLED=1
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Same project URL as VITE_SUPABASE_URL (Node does not load VITE_* unless you set it)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# CORS / cookies: production frontend origin(s)
FRONTEND_URL=https://your-domain.com
# Public site URL for links in auth flows (optional but recommended)
# PUBLIC_SITE_URL=https://your-domain.com

# Self-hosted Supabase Auth (GoTrue) custom email template host (optional)
# Point GoTrue template URLs to:
#   https://your-domain.com/api/auth/email-templates/confirmation
#   https://your-domain.com/api/auth/email-templates/invite
#   https://your-domain.com/api/auth/email-templates/magic_link
#   https://your-domain.com/api/auth/email-templates/recovery
#   https://your-domain.com/api/auth/email-templates/email_change
#   https://your-domain.com/api/auth/email-templates/reauthentication

# Payment (UddoktaPay). When set, these override Admin → UddoktaPay stored credentials.
UDDOKTAPAY_API_KEY=
UDDOKTAPAY_BASE_URL=
# Optional: force UddoktaPay on/off at checkout (true/false). When set, overrides the admin “Show on checkout” toggle.
# UDDOKTAPAY_CHECKOUT_ENABLED=false

# bKash Tokenized Checkout (optional; overrides Admin → bKash stored credentials when set)
# API base URL is chosen automatically (sandbox vs production) from Admin unless you set this.
# Use only if bKash gave you a custom host — otherwise leave unset.
# If you set any BKASH_* keys below but not BKASH_TOKENIZED_API_ROOT, set this so the URL matches the portal (sandbox vs live).
# BKASH_TOKENIZED_ENVIRONMENT=sandbox
# BKASH_TOKENIZED_API_ROOT=
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# Optional: force bKash (tokenized) on/off at checkout (true/false). When set, overrides the admin toggle.
# BKASH_TOKENIZED_CHECKOUT_ENABLED=false

# Optional: Adobe reseller
# ADOBE_API_KEY=
# ADOBE_ORGANIZATION_ID=31
# ADOBE_PRODUCTS=Default All Apps - Edition 4 configuration
# Reseller panel login — needed for removing users (provisioning uses ADOBE_API_KEY,
# but removal only works through the panel session API: username/password -> JWT).
# Required for My Users organization sync (Adobe credits-pool panel login)
ADOBE_PANEL_USERNAME=
ADOBE_PANEL_PASSWORD=
# ADOBE_PANEL_ROOT=https://reseller.ado-besoft.com/api/credits-pool

# Optional: cPanel / IMAP
# CPANEL_HOST=
# CPANEL_USERNAME=
# CPANEL_API_TOKEN=
# IMAP_HOST=
# IMAP_PORT=993

# Static SPA from Node (optional)
# SERVE_STATIC_SPA=1
# SPA_DIST_PATH=dist

# =============================================================================
# Web Push notifications (PWA)
# =============================================================================
# Generate keys:
#   npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Contact: email or URL
WEB_PUSH_SUBJECT=mailto:admin@example.com

# =============================================================================
# Subscription expiry reminders (Resend + Meta WhatsApp Cloud)
# Credentials can also be set in Admin → Subscription reminders (env wins if set).
# =============================================================================

# Resend — used by API server for Super Reseller sign-up (/api/auth/reseller-signup) and reminders
RESEND_API_KEY=your_resend_api_key_here
# Super Reseller auth email sender (domain must be verified in Resend)
# RESELLER_AUTH_FROM_EMAIL=Super Reseller <noreply@superreseller.shop>
# RESELLER_SITE_URL=https://superreseller.shop
# Supabase Auth → URL Configuration: add redirect allow list entries, e.g.
#   https://superreseller.shop/**
#   https://superreseller.shop/reseller/login
#   https://superreseller.shop/reseller/oauth/callback
#
# Admin → Platform settings → auth_settings.require_reseller_email_verification
#   (default true). When false, reseller sign-up skips verification email.
# Admin → Platform settings → auth_settings.enable_reseller_password_reset
#   (default true). When false, Super Reseller forgot-password is disabled.
# Sign-up emails: sent from YOUR API (Vercel) via RESEND_API_KEY above — not from Supabase SMTP.
# Optional: Supabase → Auth → Hooks → Send email → `custom-auth-email` + same RESEND key in Edge secrets
#   (for password reset). Redirect URLs: https://superreseller.shop/**

# Supabase
VITE_SUPABASE_URL=your_supabase_url_here
REMINDER_FROM_EMAIL=noreply@mail.vibeaccessbd.com

# Link for {renewUrl} in templates & HTML “Renew” button (if not set in admin)
REMINDER_STORE_URL=https://vibeaccessbd.com
# PUBLIC_SITE_URL=https://your-domain.com

# HTML email header label (matches branded reminder template)
# REMINDER_EMAIL_BRAND_NAME=Vibe

# Meta WhatsApp Cloud API
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_API_VERSION=v21.0

# Production: approved template with one body variable {{1}} (full reminder text)
# WHATSAPP_EXPIRY_TEMPLATE_NAME=
# WHATSAPP_EXPIRY_TEMPLATE_LANG=en

# =============================================================================
# Subscription reminder — failure alerts (after each job run)
# =============================================================================
# Total failures = emails_failed + whatsapp_failed + inbox insert errors
# REMINDER_ALERT_FAILURE_THRESHOLD=3
# REMINDER_ALERT_COOLDOWN_HOURS=24

# Slack Incoming Webhook (optional)
# REMINDER_ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Email alert (uses RESEND_API_KEY + REMINDER_FROM_EMAIL)
# REMINDER_OPS_ALERT_EMAIL=you@example.com

# =============================================================================
# Host cron (call with Authorization: Bearer <supabase JWT of admin user>)
# POST /api/cron/subscription-expiry-reminders
# POST /api/cron/burn-expired-emails
# Or use Admin → Subscription reminders → “Run reminder job now”
# =============================================================================

# =============================================================================
# Help chat / AI (optional)
# =============================================================================
# OPENAI_API_KEY=
# GOOGLE_AI_API_KEY=
# GEMINI_API_KEY=
# SUPPORT_WHATSAPP_E164=
