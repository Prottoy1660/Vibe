# =============================================================================
# Vibe — copy to ".env" and fill in values. Never commit .env.
# =============================================================================

# --- Client (Vite) — exposed to browser; use anon key only ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Public site URL (used by client; server can use VITE_APP_URL or REMINDER_STORE_URL)
VITE_APP_URL=http://localhost:5173

# Optional: API base for admin fetch (defaults to same origin in production)
# VITE_API_URL=http://localhost:3001

# --- Server / API ---
PORT=3001
# Set to 0 or false to disable hourly auto-seize of overdue redeem manual payments (default: on when API cron runs)
# REDEEM_AUTO_SEIZE_ENABLED=1
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Same project URL as VITE_SUPABASE_URL (Node does not load VITE_* unless you set it)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# CORS / cookies: production frontend origin(s)
FRONTEND_URL=https://your-domain.com

# Payment (UddoktaPay)
UDDOKTAPAY_API_KEY=
UDDOKTAPAY_BASE_URL=

# Optional: Adobe reseller
# ADOBE_API_KEY=
# ADOBE_ORGANIZATION_ID=31
# ADOBE_PRODUCTS=Default All Apps - Edition 4 configuration

# Optional: cPanel / IMAP
# CPANEL_HOST=
# CPANEL_USERNAME=
# CPANEL_API_TOKEN=
# IMAP_HOST=
# IMAP_PORT=993

# Static SPA from Node (optional)
# SERVE_STATIC_SPA=1
# SPA_DIST_PATH=dist

# =============================================================================
# Web Push notifications (PWA)
# =============================================================================
# Generate keys:
#   npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Contact: email or URL
WEB_PUSH_SUBJECT=mailto:admin@example.com

# =============================================================================
# Subscription expiry reminders (Resend + Meta WhatsApp Cloud)
# Credentials can also be set in Admin → Subscription reminders (env wins if set).
# =============================================================================

# Resend — transactional email
RESEND_API_KEY=re_Aih4dgaR_GqcLCLYn7ZMMQS4j1yQ7rLZK
REMINDER_FROM_EMAIL=noreply@mail.vibeaccessbd.shop

# Link for {renewUrl} in templates & HTML “Renew” button (if not set in admin)
REMINDER_STORE_URL=https://vibeaccessbd.shop
# PUBLIC_SITE_URL=https://your-domain.com

# HTML email header label (matches branded reminder template)
# REMINDER_EMAIL_BRAND_NAME=Vibe

# Meta WhatsApp Cloud API
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_API_VERSION=v21.0

# Production: approved template with one body variable {{1}} (full reminder text)
# WHATSAPP_EXPIRY_TEMPLATE_NAME=
# WHATSAPP_EXPIRY_TEMPLATE_LANG=en

# =============================================================================
# Subscription reminder — failure alerts (after each job run)
# =============================================================================
# Total failures = emails_failed + whatsapp_failed + inbox insert errors
# REMINDER_ALERT_FAILURE_THRESHOLD=3
# REMINDER_ALERT_COOLDOWN_HOURS=24

# Slack Incoming Webhook (optional)
# REMINDER_ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Email alert (uses RESEND_API_KEY + REMINDER_FROM_EMAIL)
# REMINDER_OPS_ALERT_EMAIL=you@example.com

# =============================================================================
# Host cron (call with Authorization: Bearer <supabase JWT of admin user>)
# POST /api/cron/subscription-expiry-reminders
# POST /api/cron/burn-expired-emails
# Or use Admin → Subscription reminders → “Run reminder job now”
# =============================================================================

# =============================================================================
# Help chat / AI (optional)
# =============================================================================
# OPENAI_API_KEY=
# GOOGLE_AI_API_KEY=
# GEMINI_API_KEY=
# SUPPORT_WHATSAPP_E164=
